PORT=3000
NODE_ENV=production

# Postgres donde n8n guarda las conversaciones.
# Formato: postgres://usuario:contraseña@host:5432/basededatos
# Si la contraseña lleva caracteres especiales (@, :, /, #…), escríbelos codificados (%40, %3A…).
DATABASE_URL=postgres://panel_conversaciones:CAMBIA_ESTA_CONTRASEÑA@10.210.19.220:5432/unnic
# true solo si Postgres exige conexión cifrada
DATABASE_SSL=false

# Clave con la que n8n cifra los mensajes (la misma que usa guardar_conversacion).
# Si hay mensajes cifrados con claves distintas, ponlas separadas por comas.
ENCRYPTION_KEY=la_clave_de_cifrado_de_n8n

# Clave para entrar al panel y usar la API. Genera una larga, por ejemplo con:
#   openssl rand -hex 32
API_ACCESS_KEY=pon_una_clave_larga_y_segura

# Opcional: solo si otra web distinta del panel va a llamar a la API (separado por comas)
CORS_ORIGINS=

# Opcional: pon 1 si el panel queda detrás de un proxy inverso (nginx, Traefik…)
TRUST_PROXY=

# Opcional: resúmenes con IA. Si no se rellena, el panel funciona igual pero
# los botones de resumen darán error. Ojo: activa el envío de las
# conversaciones a OpenAI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
